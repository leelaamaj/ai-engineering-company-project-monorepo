{
  "name": "trackflow-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./styles.input.css -o ./styles.css --minify",
    "start": "http-server . -p 3000 -a 0.0.0.0 -c-1",
    "test": "playwright test",
    "audit": "lighthouse http://localhost:3000 --only-categories=performance,accessibility,best-practices,seo --output=html --output=json --output-path=./docs/lighthouse --chrome-flags='--headless --no-sandbox'"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/cli": "4.1.14",
    "http-server": "14.1.1",
    "lighthouse": "13.5.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14"
  }
}
